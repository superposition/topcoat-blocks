#!/usr/bin/env sh
set -eu

workspace_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

cd "$workspace_dir"
package_files=$(cargo package -p topcoat-blocks --allow-dirty --list)

case "$package_files" in
  *"apps/"*|*"coatcheck/"*|*"Coatcheck.toml"*|*"package.json"*|*"scripts/"*|*"skills/"*)
    printf '%s\n' "The published crate would contain review-harness files." >&2
    exit 1
    ;;
esac

for component in \
  sign_in_form \
  product_card \
  catalog_filter_bar \
  cart_line_item \
  order_totals \
  shipping_address_form \
  payment_route_selector \
  payment_status \
  order_receipt
do
  case "$package_files" in
    *"registry/components/$component.rs"* ) ;;
    *)
      printf '%s\n' "The $component registry source is missing from the package." >&2
      exit 1
      ;;
  esac
done

cargo package -p topcoat-blocks --allow-dirty

printf '%s\n' "Package smoke passed: registry source is isolated from the review harness."
